#!/usr/bin/env bash
# devlog_update — summarize beads closed since the last watermark, for a git-time
# development trace. Two modes:
#   --trailer          print a "Beads closed" summary to stdout (for the commit
#                      message). No side effects, does NOT advance the watermark.
#   --commit <sha>     append an entry (with sha) to .beads/DEVLOG.md and advance
#                      the watermark. Run from a post-commit hook.
#
# Watermark: .beads/.devlog-mark (ISO8601). First run defaults to HEAD's date, so
# only beads closed after the current HEAD are reported. Keep the mark git-ignored
# (the installer adds it to .git/info/exclude). Gate evidence is pulled from each
# bead's ledger .beads/gates/<id>.md (its CHECK: lines).
set -euo pipefail
case "${1:-}" in -h|--help) sed -n '2,/^set -/{/^set -/d;s/^# \{0,1\}//p;}' "$0"; exit 0;; esac

mode="${1:---trailer}"
sha="${2:-}"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
beads_dir="$repo_root/.beads"
mark_file="$beads_dir/.devlog-mark"
devlog="$beads_dir/DEVLOG.md"
gates_dir="$beads_dir/gates"

[[ -d "$beads_dir" ]] || exit 0
command -v bd >/dev/null 2>&1 || exit 0

if [[ -f "$mark_file" ]]; then
  mark="$(cat "$mark_file")"
else
  mark="$(git -C "$repo_root" log -1 --format=%cI 2>/dev/null || echo '1970-01-01T00:00:00Z')"
fi

# id<TAB>title for beads closed strictly after the watermark
closed_lines="$(bd list --all --closed-after "$mark" --json 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    d = []
for i in d:
    if i.get("status") == "closed":
        print(i["id"] + "\t" + i.get("title", ""))
')"

evidence() { # $1 = bead id -> "; "-joined CHECK: lines from its ledger
  local f="$gates_dir/$1.md"
  [[ -f "$f" ]] || return 0
  grep -iE '^[[:space:]]*CHECK:' "$f" 2>/dev/null | sed -E 's/^[[:space:]]*CHECK:[[:space:]]*//' | paste -sd';' - 2>/dev/null
}

render_block() { # emit "- id  title  \u2713 checks" lines
  while IFS=$'\t' read -r id title; do
    [[ -n "$id" ]] || continue
    local ev; ev="$(evidence "$id")"
    if [[ -n "$ev" ]]; then
      printf -- '- %s  %s  \u2713 %s\n' "$id" "$title" "$ev"
    else
      printf -- '- %s  %s\n' "$id" "$title"
    fi
  done <<< "$closed_lines"
}

[[ -n "$closed_lines" ]] || exit 0

case "$mode" in
  --trailer)
    echo "Beads closed in this commit:"
    render_block
    ;;
  --commit)
    when="$(git -C "$repo_root" log -1 --format=%cI "$sha" 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
    subj="$(git -C "$repo_root" log -1 --format=%s "$sha" 2>/dev/null || echo '')"
    short="$(git -C "$repo_root" rev-parse --short "$sha" 2>/dev/null || echo "$sha")"
    [[ -f "$devlog" ]] || printf '# Development log\n\n_Beads closed per commit (rolling, auto-appended). Evidence = passing gate CHECKs._\n' > "$devlog"
    {
      printf '\n## %s  %s  %s\n' "$when" "$short" "$subj"
      render_block
    } >> "$devlog"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$mark_file"
    ;;
  *)
    echo "devlog_update: unknown mode: $mode" >&2
    exit 2
    ;;
esac
