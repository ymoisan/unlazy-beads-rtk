# env.sh.example — copy to env.sh (git-ignored), then set your absolute $HOME.
#
#   cp env.sh.example env.sh && echo "export UNLAZY_HOME=\"$HOME\"" >> env.sh
#
# Leaving UNLAZY_HOME as "$HOME" works for the user who owns these files. Pin an
# absolute path only if a different user runs the tools against this checkout.
export UNLAZY_HOME="${HOME}"
