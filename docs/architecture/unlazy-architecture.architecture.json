    "views": [
      {
        "id": "arm-once",
        "label": "Arm once",
        "focus": ["agent", "install", "stop_gate", "state"],
        "note": "install-stop-hook wires the VS Code adapter and writes the armed marker into ~/.unlazy so a disabled hook can't masquerade as a passing one."
      },
      {
        "id": "enforce",
        "label": "Enforce a gate",
        "focus": ["agent", "stop_gate", "gate", "gates_ledger", "bd"],
        "note": "At turn end stop-gate runs each in-progress bead's CHECK; an unsatisfied ledger fails closed instead of allowing a silent stop."
      },
      {
        "id": "session-start",
        "label": "Session-start doctor",
        "focus": ["agent", "hook_doctor", "state", "stale", "bd"],
        "note": "hook-doctor reads the markers without needing the hook to run, so it detects an INACTIVE hook and reports stale in-progress beads."
      }
    ]
  },
