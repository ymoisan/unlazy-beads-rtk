  "cards": [
    {
      "dot": "cyan",
      "title": "What this repo installs",
      "items": [
        "gate / stop-gate / hook-doctor / stale-beads — tool-agnostic shell",
        "install-stop-hook — the VS Code / Copilot adapter",
        "Runtime markers live in ~/.unlazy (heartbeat · status · session-start)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fail-closed enforcement",
      "items": [
        "A bead cannot close until its acceptance CHECK passes",
        "stop-gate re-runs the CHECK at turn end, not just when asked",
        "hook-doctor reads markers without the hook, so a dead hook surfaces"
      ]
    },
    {
      "dot": "violet",
      "title": "User-provided prerequisites",
      "items": [
        "beads (bd) is installed and configured by the user",
        "beads owns Dolt — embedded or sql-server, the user's choice",
        "This repo never installs or manages Dolt"
      ]
    }
