#!/usr/bin/env bash
# gate — bind a beads issue to an unlazy gate ledger and verify before close.
#
# A bead's runnable acceptance lives in a ledger at .beads/gates/<bead-id>.md
# (override with GATE_DIR). This wrapper runs the unlazy checker against that
# ledger and only closes the bead when every gate passes with evidence.
#
# Usage:
#   gate <bead-id>            reverify the ledger (default; re-executes checks)
#   gate <bead-id> --status   parse/report only, no execution
#   gate <bead-id> --approve  approve+run pending checks (first run of new checks)
#   gate <bead-id> --lint     lint the ledger for un-failable oracles
#   gate <bead-id> --new      scaffold a ledger from the template
#   gate <bead-id> --close [--note "how it was built"]
#                             reverify, then `bd close <bead-id>` iff all gates
#                             pass; append the handoff note to each open bead
#                             this one was blocking (WALKTHROUGH §12). The note
#                             is REQUIRED when the bead unblocks others (refuses
#                             without it); omit it when there are no dependents.
#
# Conventions (see ~/.agents/unlazy-beads-rtk/beads_unlazy_plan.md):
#   - Route CHECK commands through rtk (rtk cargo test, rtk npm ...). rtk's
#     rewrite hook does NOT fire under Copilot/Cursor, so write `rtk` explicitly.
#   - Approvals bind the exact command string; keep the rtk-vs-raw choice stable.
#   - Approvals live under ~/.unlazy/approved (outside every repo, enforced).
set -euo pipefail
case "${1:-}" in -h|--help) sed -n '2,/^set -/{/^set -/d;s/^# \{0,1\}//p;}' "$0"; exit 0;; esac

SKILL_DIR="${UNLAZY_SKILL_DIR:-$HOME/.agents/skills/unlazy}"
CHECKER="$SKILL_DIR/scripts/gate_check.py"
LINTER="$SKILL_DIR/scripts/gate_lint.py"
TEMPLATE="${GATES_TEMPLATE:-$HOME/.agents/unlazy-beads-rtk/GATES.template.md}"
HANDOFF="${UNLAZY_HANDOFF:-$HOME/.agents/unlazy-beads-rtk/handoff_note.py}"

die() { echo "gate: $*" >&2; exit 2; }

[[ $# -ge 1 ]] || die "usage: gate <bead-id> [--status|--approve|--lint|--new|--close]"
[[ -f "$CHECKER" ]] || die "checker not found: $CHECKER (set UNLAZY_SKILL_DIR)"

bead="$1"; shift || true
action="${1:-reverify}"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
gate_dir="${GATE_DIR:-$repo_root/.beads/gates}"
ledger="$gate_dir/$bead.md"

case "$action" in
  --new)
    [[ -f "$TEMPLATE" ]] || die "template not found: $TEMPLATE"
    [[ -e "$ledger" ]] && die "ledger already exists: $ledger"
    mkdir -p "$gate_dir"
    sed "s/<BEAD-ID>/$bead/g" "$TEMPLATE" > "$ledger"
    echo "created $ledger — edit gates, then: gate $bead --lint && gate $bead --approve"
    ;;
  --lint)
    [[ -f "$ledger" ]] || die "no ledger: $ledger (run: gate $bead --new)"
    python3 "$LINTER" "$ledger"
    ;;
  --status)
    [[ -f "$ledger" ]] || die "no ledger: $ledger (run: gate $bead --new)"
    python3 "$CHECKER" --status --root "$repo_root" "$ledger"
    ;;
  --approve)
    [[ -f "$ledger" ]] || die "no ledger: $ledger (run: gate $bead --new)"
    python3 "$CHECKER" --approve --root "$repo_root" "$ledger"
    ;;
  --close)
    [[ -f "$ledger" ]] || die "no ledger: $ledger (run: gate $bead --new)"
    handoff_note=""
    [[ "${2:-}" == "--note" ]] && handoff_note="${3:-}"
    if python3 "$CHECKER" --reverify --root "$repo_root" "$ledger"; then
      # if this bead unblocks others, a handoff note is mandatory — refuse before close
      deps=""
      [[ -f "$HANDOFF" ]] && deps="$(python3 "$HANDOFF" --deps "$bead" 2>/dev/null || true)"
      if [[ -n "$deps" && -z "$handoff_note" ]]; then
        echo "HANDOFF NOTE REQUIRED: $bead unblocks $(echo "$deps" | tr '\n' ' ')— re-run: gate $bead --close --note \"how it was built\"" >&2
        exit 1
      fi
      # store the note on the master itself (source of truth / audit)
      if [[ -n "$handoff_note" ]]; then
        bd close "$bead" --reason "$handoff_note"
      else
        bd close "$bead"
      fi
      # mirror the note onto each open blocking-dependent (passive delivery);
      # additive, best-effort: never fails the close
      [[ -n "$deps" && -f "$HANDOFF" ]] && python3 "$HANDOFF" "$bead" "$handoff_note" || true
    else
      echo "HANDOFF REQUIRED: gates unmet for $bead — bead left open" >&2
      exit 1
    fi
    ;;
  reverify|"")
    [[ -f "$ledger" ]] || die "no ledger: $ledger (run: gate $bead --new)"
    python3 "$CHECKER" --reverify --root "$repo_root" "$ledger"
    ;;
  *)
    die "unknown action: $action"
    ;;
esac
