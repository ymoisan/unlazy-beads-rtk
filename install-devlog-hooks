#!/usr/bin/env bash
# install-devlog-hooks — link the devlog prepare-commit-msg + post-commit hooks
# into a repo's .git/hooks and git-ignore the local watermark file.
#
# Usage: install-devlog-hooks [repo-path]   (defaults to the current repo)
# Chain-safe: refuses to clobber an existing non-symlink hook and prints how to
# chain it manually instead.
set -euo pipefail
case "${1:-}" in -h|--help) sed -n '2,/^set -/{/^set -/d;s/^# \{0,1\}//p;}' "$0"; exit 0;; esac

repo_root="$(git -C "${1:-.}" rev-parse --show-toplevel)"
hooks_dir="$repo_root/.git/hooks"
src="$HOME/.agents/unlazy-beads-rtk/hooks"

for h in prepare-commit-msg post-commit; do
  dest="$hooks_dir/$h"
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    echo "install-devlog-hooks: $dest exists and is not a symlink — NOT overwriting."
    echo "  chain it manually by adding this line to that hook:"
    echo "    \"$src/$h\" \"\$@\""
  else
    ln -sf "$src/$h" "$dest"
    chmod +x "$src/$h"
    echo "linked $dest -> $src/$h"
  fi
done

excl="$repo_root/.git/info/exclude"
if ! grep -qxF '.beads/.devlog-mark' "$excl" 2>/dev/null; then
  echo '.beads/.devlog-mark' >> "$excl"
  echo "git-ignored .beads/.devlog-mark (local watermark)"
fi

echo "done. Commit .beads/DEVLOG.md as it grows; the watermark stays local."
