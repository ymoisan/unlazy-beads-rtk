#!/usr/bin/env python3
"""beads_verify <plan.json> — print the WBS-sorted blocks table for a plan's beads.

Companion to beads_gen: reads the sidecar manifest (<plan>.beads.json) to scope to
exactly the beads this plan created, queries bd for their live dependencies, and
prints each bead's blocks-edges (the ones that determine execution order) sorted
by WBS code. Parent-child edges are intentionally omitted — this table is about
"what must finish before this can start".

A bead is flagged READY when it is still open and every one of its blocks-parents
is closed. bd ready remains the authoritative scheduler (it also honours
parent-child); this is a human-readable audit of the blocks wiring.

Usage:
  beads_verify <plan.json>
"""
import json
import os
import subprocess
import sys
from pathlib import Path


def die(msg):
    print(f"beads_verify: {msg}", file=sys.stderr)
    sys.exit(2)


def bd_json(args):
    out = subprocess.run(["bd", *args], capture_output=True, text=True)
    txt = out.stdout.strip()
    # bd may prepend a permissions warning line on some filesystems; find the JSON.
    start = txt.find("[")
    return json.loads(txt[start:]) if start != -1 else []


def wbs(issue):
    for label in issue.get("labels") or []:
        if label.startswith("wbs:"):
            return label[4:]
    return "?"


def gate(issue):
    for label in issue.get("labels") or []:
        if label.startswith("gate:"):
            return label[5:]
    return "—"


def review_mark(issue):
    # V column: R = flagged (review:req), ✓ = review:ok, ✗ = review:block.
    labs = issue.get("labels") or []
    if "review:block" in labs:
        return "✗"
    if "review:ok" in labs:
        return "✓"
    if "review:req" in labs:
        return "R"
    return ""


def model(issue):
    # model:<tier> label -> tier name; absent means the lead (controller) runs it.
    for label in issue.get("labels") or []:
        if label.startswith("model:"):
            return label[6:]
    return "lead"


def _load_tiers():
    # full tier list from models.json (symlink-safe); [] if absent/broken.
    p = Path(os.path.realpath(__file__)).parent / "models.json"
    if not p.is_file():
        return []
    try:
        return json.loads(p.read_text()).get("tiers", [])
    except json.JSONDecodeError:
        return []


_TIERS = _load_tiers()
_TIER_BY_NAME = {t.get("name"): t for t in _TIERS if t.get("name")}
_LEAD_REASON = "controller: judgment, one-liners, manual gates"


def model_letter(issue):
    name = model(issue)
    if name in ("lead", "none", ""):
        return "l"
    t = _TIER_BY_NAME.get(name)
    return (t.get("tag") or name[:1]) if t else name[:1]


def _tier_reason(name):
    if name in (None, "", "lead", "none"):
        return _LEAD_REASON
    t = _TIER_BY_NAME.get(name)
    return (t.get("reason") or t.get("desc") or name) if t else name


def _wbs_codes(nodes):
    # Recompute the WBS code per node key, mirroring wbs_prefix (type-initial + index).
    by_key = {n.get("key"): n for n in nodes}
    children, roots = {}, []
    for n in nodes:
        p = n.get("parent_key")
        if p and p in by_key:
            children.setdefault(p, []).append(n)
        else:
            roots.append(n)
    codes = {}

    def walk(lst, parent):
        for i, n in enumerate(lst, 1):
            letter = (n.get("type") or "task")[0].upper()
            code = f"{letter}{i}" if not parent else f"{parent}.{letter}{i}"
            codes[n.get("key")] = code
            walk(children.get(n.get("key"), []), code)

    walk(roots, "")
    return codes


def blocks_parents(issue):
    # dependency {type: "blocks"} means this issue depends on depends_on_id (it must finish first).
    return [d["depends_on_id"] for d in (issue.get("dependencies") or []) if d.get("type") == "blocks"]


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if argv else 2)

    plan = Path(argv[0]).resolve()
    if not plan.is_file():
        die(f"plan not found: {plan}")
    manifest = plan.with_suffix(".beads.json") if plan.suffix == ".json" else Path(str(plan) + ".beads.json")
    if not manifest.is_file():
        die(f"manifest not found: {manifest} — run beads_gen first")

    ids = set(json.loads(manifest.read_text()))
    if not ids:
        die(f"manifest is empty: {manifest}")

    issues = {i["id"]: i for i in bd_json(["list", "--all", "--json"]) if i["id"] in ids}
    missing = ids - set(issues)
    if missing:
        die(f"{len(missing)} manifest bead(s) not found in bd (stale manifest?): {', '.join(sorted(missing))}")

    def is_closed(issue):
        return str(issue.get("status", "")).lower() in ("closed", "done")

    # WHY column: read the plan's per-node `why` (prose, never stored in bd),
    # mapped to beads by recomputed WBS; fall back to the tier's default reason.
    plan_nodes = json.loads(plan.read_text()).get("nodes", [])
    codes = _wbs_codes(plan_nodes)
    why_by_wbs = {}
    for n in plan_nodes:
        c = codes.get(n.get("key"))
        if c:
            why_by_wbs[c] = n.get("why") or _tier_reason(n.get("model"))

    def trunc(s, n):
        return s if len(s) <= n else s[: n - 1].rstrip() + "…"

    rows = sorted(issues.values(), key=lambda i: wbs(i))
    w_wbs = max([len("WBS")] + [len(wbs(i)) for i in rows])
    w_why = min(40, max([len("WHY")] + [len(why_by_wbs.get(wbs(i), "—")) for i in rows]))

    header = (f"{'WBS':<{w_wbs}}  {'ID':<8}  {'STATUS':<8}  {'GATE':<6}  "
              f"{'M':<1}  {'V':<1}  {'WHY':<{w_why}}  BLOCKED-BY (must finish first)")
    print(f"Plan: {plan.name}   ({len(rows)} beads)")
    print(header)
    print("-" * len(header))

    ready = []
    anomalies = []
    for i in rows:
        parents = blocks_parents(i)
        # Flag blocks-parents that fall outside this plan (cross-plan / dangling).
        ext = [p for p in parents if p not in issues]
        if ext:
            anomalies.append(f"{wbs(i)} ({i['id']}) blocked-by out-of-plan bead(s): {', '.join(ext)}")
        parent_str = ", ".join(sorted(f"{wbs(issues[p])}({p})" for p in parents if p in issues)) or "—"
        open_blockers = [p for p in parents if p in issues and not is_closed(issues[p])]
        flag = ""
        if not is_closed(i) and not open_blockers:
            flag = "  ← READY"
            ready.append(wbs(i))
        status = str(i.get("status", "?")).lower()
        why = trunc(why_by_wbs.get(wbs(i), "—"), w_why)
        print(f"{wbs(i):<{w_wbs}}  {i['id']:<8}  {status:<8}  {gate(i):<6}  "
              f"{model_letter(i):<1}  {review_mark(i):<1}  {why:<{w_why}}  {parent_str}{flag}")

    print("-" * len(header))
    # Embedded legend: the single-letter M column + the WHY source.
    print("MODEL tiers (single-letter M column):")
    print(f"  l  lead   — {_LEAD_REASON}")
    for t in _TIERS:
        tag = t.get("tag") or (t.get("name") or "?")[:1]
        state = "" if t.get("enabled") else " (disabled)"
        print(f"  {tag}  {t.get('name', ''):<6} — {t.get('reason') or t.get('desc', '')}{state}")
    print("WHY = per-bead justification (plan `why`, else the tier default).")
    print("V (review): R = flagged review:req, ✓ = review:ok, ✗ = review:block.")
    print()
    print(f"Ready now (blocks satisfied, still open): {', '.join(ready) if ready else 'none'}")
    if anomalies:
        print("\nAnomalies:")
        for a in anomalies:
            print(f"  ! {a}")
    print("\nNote: `bd ready` is authoritative (also honours parent-child); this audits blocks-edges only.")


if __name__ == "__main__":
    main()
